    "周购_本周已买": {
        "desc": "名字上方是「已售罄」章或「每周限购(1/1)」→ 本周已经买过（章会盖住数字，OCR 会把「每周限购」和「(1/1)」拆成两段，所以分开认）",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "已售罄|售罄|^[(（]?\\s*1\\s*/\\s*1\\s*[)）]?$|每周限购\\s*[(（]\\s*1\\s*/\\s*1",
                "roi": "周购_找礼盒",
                "roi_offset": [
                    -70,
                    -130,
                    140,
                    120
                ]
            }
        },
        "next": [
            "Flag_月卡周购完成"
        ],
        "focus": {
            "Node.Action.Succeeded": "[color:Dimgray]超值颜料礼盒本周已买过[/color]"
        }
    },
