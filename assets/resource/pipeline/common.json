    "公共_打开任务页": {
        "desc": "主界面左上角的日历图标（两种主题各一张模板）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "home/日历_全景.png",
                    "home/日历_默认.png"
