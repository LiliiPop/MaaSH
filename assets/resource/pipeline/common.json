        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 800,
            "timeout": 10000
        },
        "timeout": 15000,
        "next": [
            "公共_日常列表就绪",
            "公共_切到日常页"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    },
    "公共_切到日常页": {
        "desc": "任务页左侧「日常」页签",
