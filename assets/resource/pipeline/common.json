        "timeout": 30000,
        "next": [
            "Flag_在主界面",
            "[JumpBack]公共_获得奖励",
            "[JumpBack]公共_点击空白继续",
            "[JumpBack]公共_关闭公告",
            "[JumpBack]公共_返回按钮"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    },
