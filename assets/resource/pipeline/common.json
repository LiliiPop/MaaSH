    "公共_返回按钮": {
        "desc": "子界面左上角的返回键：钢笔尖样式（快速模式等）或蝴蝶样式（假日等）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "common/返回按钮.png",
                    "common/返回按钮_蝴蝶.png"
                ],
                "roi": [
                    20,
                    10,
                    100,
                    80
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "max_hit": 10,
        "post_wait_freezes": {
            "time": 500,
            "timeout": 10000
        }
    },
    "公共_关闭公告": {
        "desc": "活动公告：盖在主界面上，底部「图鉴」仍可见而右侧「画廊」被挡住。必须排在主界面识别之后（主界面先没命中才会走到这里）。点公告外的空白处关闭，公告数量不定",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "图鉴",
                "roi": [
                    700,
                    630,
                    180,
                    75
