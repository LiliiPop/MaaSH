    "公共_任务失败": {
        "desc": "超时或卡住时落到这里：记 Red 日志后结束当前任务，交给下一个任务继续",
        "focus": {
            "Node.Action.Succeeded": "[color:Red]当前任务超时或卡住，已跳过[/color]"
        }
    },
