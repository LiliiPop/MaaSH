{
    "日程_流程": {
        "desc": "日程主循环：两页安排（校园活动 + 特殊邀约），特殊邀约需要去地图找信封、对话、选回复",
        "timeout": 180000,
        "next": [
            "Flag_日程完成",
            "Flag_日程今日已完成",
            "[JumpBack]日程_翻页",
            "[JumpBack]日程_随机选择",
            "日程_选择回复",
            "[JumpBack]日程_对话推进",
            "[JumpBack]日程_点击信封",
            "[JumpBack]日程_点击信封_场景",
            "[JumpBack]公共_获得奖励",
            "[JumpBack]公共_点击空白继续",
            "[JumpBack]日程_场景右走"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    },
    "日程_随机选择": {
        "desc": "日程页左下「随机选择」，随后点「确定」",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "随机选择",
                "roi": [
                    115,
                    600,
                    125,
                    50
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "max_hit": 6,
        "post_wait_freezes": {
            "time": 500,
            "timeout": 5000
        },
        "next": [
            "日程_确定"
        ]
    },
    "日程_确定": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "确定",
                "roi": [
                    925,
                    595,
                    110,
                    55
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 1000,
            "timeout": 15000
        },
        "timeout": 5000
    },
    "日程_翻页": {
        "desc": "第一页活动完成（右下 1/2）：点箭头进入下一页",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^1/2$",
                "roi": [
                    1070,
                    600,
                    90,
                    50
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1090,
                    550,
                    60,
                    55
                ]
            }
        },
        "max_hit": 4,
        "post_wait_freezes": {
            "time": 800,
            "timeout": 10000
        }
    },
    "日程_对话推进": {
        "desc": "顶部对话框：点对话框继续",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "schedule/对话框标记.png",
                "roi": [
                    200,
                    30,
                    150,
                    90
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    300,
                    95,
                    450,
                    60
                ]
            }
        },
        "max_hit": 20,
        "pre_wait_freezes": {
            "time": 800,
            "timeout": 5000
        }
    },
    "日程_选择回复": {
        "desc": "出现回复选项时固定选第一个（最上面的）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "schedule/回复选项.png",
                "roi": [
                    880,
                    420,
                    180,
                    280
                ],
                "threshold": 0.8,
                "order_by": "Vertical",
                "index": 0
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -420,
                    -10,
                    0,
                    0
                ]
            }
        },
        "max_hit": 6,
        "post_wait_freezes": {
            "time": 800,
            "timeout": 8000
        },
        "next": [
            "日程_等待完成"
        ]
    },
    "日程_等待完成": {
        "desc": "选完回复后：点对话或空白处推进，直到出现「完成 2/2」",
        "timeout": 90000,
        "next": [
            "Flag_日程完成",
            "[JumpBack]日程_再次回复",
            "[JumpBack]日程_对话推进",
            "[JumpBack]日程_空白推进"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    },
    "日程_空白推进": {
        "desc": "剧情中无对话框时点下方空白处推进（只在选完回复后使用）",
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    620,
                    690,
                    40,
                    20
                ]
            }
        },
        "max_hit": 20,
        "pre_wait_freezes": {
            "time": 1500,
            "timeout": 10000
        }
    },
    "Flag_日程完成": {
        "desc": "特殊邀约完成页：右下「完成」+「2/2」，点完成收尾",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "完成",
                                "roi": [
                                    1075,
                                    545,
                                    90,
                                    65
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "^2/2$",
                                "roi": [
                                    1070,
                                    600,
                                    90,
                                    50
                                ]
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1090,
                    550,
                    60,
                    55
                ]
            }
        },
        "post_wait_freezes": {
            "time": 800,
            "timeout": 10000
        },
        "focus": {
            "Node.Action.Succeeded": "[color:Limegreen]日程已安排完成[/color]"
        }
    },
    "日程_再次回复": {
        "desc": "对话中再次出现回复选项：同样选第一个",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "schedule/回复选项.png",
                "roi": [
                    880,
                    420,
                    180,
                    280
                ],
                "threshold": 0.8,
                "order_by": "Vertical",
                "index": 0
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    -420,
                    -10,
                    0,
                    0
                ]
            }
        },
        "max_hit": 6,
        "post_wait_freezes": {
            "time": 800,
            "timeout": 8000
        }
    },
    "Flag_日程今日已完成": {
        "desc": "今天已安排过：日程页显示回顾总结（右上角有日期「x月」）",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "日程",
                                "roi": [
                                    120,
                                    15,
                                    110,
                                    55
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "\\d+月",
                                "roi": [
                                    1070,
                                    100,
                                    90,
                                    50
                                ]
                            }
                        }
                    }
                ]
            }
        },
        "focus": {
            "Node.Action.Succeeded": "[color:Limegreen]日程今天已安排完成[/color]"
        }
    },
    "日程_场景右走": {
        "desc": "特殊邀约场景里画面中没有信封：点右半边地面，主角向右走、场景右移，然后再找信封（先认左上角返回键确认在场景里；画面静止后才点，避免对话过场中误点）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/返回按钮.png",
                "roi": [
                    0,
                    0,
                    140,
                    110
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1100,
                    655,
                    150,
                    40
                ]
            }
        },
        "max_hit": 8,
        "pre_wait_freezes": {
            "time": 1000,
            "timeout": 8000
        },
        "post_wait_freezes": {
            "time": 800,
            "timeout": 10000
        },
        "focus": {
            "Node.Action.Starting": "[color:Dimgray]画面里没找到信封，向右走一段再找[/color]"
        }
    },
    "日程_点击信封": {
        "desc": "校园地图上头顶有信封的人物：点信封正下方的头像（点信封本身没有反应）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "schedule/信封_地图.png",
                "threshold": 0.75
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    0,
                    65,
                    0,
                    0
                ]
            }
        },
        "max_hit": 8,
        "post_wait_freezes": {
            "time": 1000,
            "timeout": 5000
        }
    },
    "日程_点击信封_场景": {
        "desc": "特殊邀约场景里人物旁的信封气泡",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "schedule/信封_场景.png",
                "threshold": 0.75
            }
        },
        "action": {
            "type": "Click"
        },
        "max_hit": 8,
        "post_wait_freezes": {
            "time": 1000,
            "timeout": 5000
        }
    }
}