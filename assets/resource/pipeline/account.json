{
    "账号_开始": {
        "desc": "启动完成后切换到指定账号（选项「使用指定账号登录」）。只做一次：切完回到主界面再次到达这里时走 账号_已切换",
        "max_hit": 1,
        "next": [
            "账号_打开设置_全景",
            "账号_打开设置_默认",
            "[JumpBack]公共_晚点再说",
            "[JumpBack]公共_生日弹窗等待",
            "[JumpBack]公共_稍后再说",
            "[JumpBack]公共_不再提醒",
            "[JumpBack]公共_我知道了",
            "[JumpBack]公共_返回主界面"
        ],
        "timeout": 30000,
        "on_error": [
            "公共_任务失败"
        ],
        "focus": {
            "Node.Action.Starting": "[color:Dimgray]切换账号：设置 → 退出账号 → 从历史账号里选[/color]"
        }
    },
