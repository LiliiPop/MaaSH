            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "退出账号",
                                "roi": [
                                    480,
                                    200,
                                    320,
                                    60
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "^确\\s*定$",
                                "roi": [
                                    700,
                                    440,
                                    220,
                                    60
                                ]
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
