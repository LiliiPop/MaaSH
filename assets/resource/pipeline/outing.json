            "出行赠礼_打开头像栏"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    },
    "出行赠礼_打开头像栏": {
        "desc": "左下角当前角色头像，点开五人头像栏（被弹窗挡住没点到时，回到开头重新来，最多 4 次）",
        "recognition": {
