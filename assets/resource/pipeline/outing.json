{
    "出行赠礼_流程": {
        "desc": "在课后出行页：先换成选定的角色，再打开赠礼",
        "timeout": 60000,
        "next": [
            "[JumpBack]公共_晚点再说",
            "[JumpBack]出行_去赴约",
            "出行赠礼_打开头像栏"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    },
    "出行赠礼_打开头像栏": {
        "desc": "左下角当前角色头像，点开五人头像栏",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "课后出行",
                "roi": [
                    95,
                    10,
                    200,
                    60
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    30,
                    628,
                    55,
                    50
                ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "timeout": 1500,
            "rate_limit": 200
        },
        "next": [
            "出行赠礼_选择角色"
        ]
    },
    "出行赠礼_选择角色": {
        "desc": "在头像栏里点选定的角色（按发色模板识别）；由选项「赠礼角色」改写模板",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "outing/艾因.png",
                "roi": [
                    30,
                    610,
                    520,
                    90
                ],
                "threshold": 0.75
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 500,
            "timeout": 3000,
            "rate_limit": 200
        },
        "timeout": 10000,
        "next": [
            "出行赠礼_打开赠礼"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    },
    "出行赠礼_打开赠礼": {
        "desc": "底部「赠礼」",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^赠礼$",
                "roi": [
                    870,
                    655,
                    90,
                    45
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 500,
            "timeout": 1500,
            "rate_limit": 200
        },
        "timeout": 15000,
        "next": [
            "出行赠礼_点第一个礼物"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    },
    "出行赠礼_赠送": {
        "desc": "「赠送」按钮（数量保持 1）。之后不在本页判断成功，回任务页看「给任意角色赠送礼物」是否已可领取",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "赠\\s*送",
                "roi": [
                    880,
                    630,
                    140,
                    60
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 500,
            "timeout": 1500,
            "rate_limit": 200
        },
        "timeout": 10000,
        "next": [
            "出行赠礼_已送出",
            "[JumpBack]公共_获得奖励",
            "[JumpBack]公共_点击空白继续"
        ],
        "on_error": [
            "公共_进入日常列表"
        ]
    },
    "出行收礼_流程": {
        "desc": "在课后出行页反复点人物，直到弹出「恭喜获得」",
        "timeout": 180000,
        "next": [
            "[JumpBack]公共_晚点再说",
            "[JumpBack]出行_去赴约",
            "出行收礼_关闭奖励",
            "出行收礼_点人物"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    },
    "出行收礼_点人物": {
        "desc": "点人物身体（画面中部偏上，避开底部按钮和对话框）。每点一次都等几秒看有没有弹奖励，避免下一次点击把弹窗点掉",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "课后出行",
                "roi": [
                    95,
                    10,
                    200,
                    60
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    600,
                    230,
                    80,
                    90
                ]
            }
        },
        "max_hit": 30,
        "post_wait_freezes": {
            "time": 500,
            "timeout": 1500,
            "rate_limit": 200
        },
        "next": [
            "出行收礼_等奖励"
        ]
    },
    "出行收礼_关闭奖励": {
        "desc": "「恭喜获得」弹窗：点下方空白处关闭，然后回任务页看「在出行中收到礼物」是否已可领取",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "恭喜获得|点击空白处继续",
                "roi": [
                    420,
                    160,
                    440,
                    520
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    560,
                    630,
                    160,
                    30
                ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "timeout": 1500,
            "rate_limit": 200
        },
        "next": [
            "公共_进入日常列表"
        ],
        "focus": {
            "Node.Action.Starting": "[color:Dimgray]收到礼物，回任务页确认[/color]"
        }
    },
    "出行_去赴约": {
        "desc": "之前答应过角色的邀约时，点「前往」会先到地点列表（「相约之地」）：点「去赴约」进入出行，再继续原流程（赴约也是出行的一部分）",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "相约之地",
                                "roi": [
                                    90,
                                    90,
                                    140,
                                    45
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "去赴约",
                                "roi": [
                                    950,
                                    585,
                                    200,
                                    65
                                ]
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        },
        "max_hit": 2,
        "post_wait_freezes": {
            "time": 500,
            "timeout": 3000,
            "rate_limit": 200
        },
        "focus": {
            "Node.Action.Starting": "[color:Dimgray]有已答应的邀约：先去赴约[/color]"
        }
    },
    "出行收礼_等奖励": {
        "desc": "点完人物后最多等 1.5 秒，看有没有弹出「恭喜获得」",
        "timeout": 1500,
        "next": [
            "出行收礼_关闭奖励"
        ],
        "on_error": [
            "出行收礼_流程"
        ]
    },
    "出行赠礼_已送出": {
        "desc": "出现「好感度+N」：送出去了，回任务页复核",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "好感度\\s*\\+\\s*\\d+",
                "roi": [
                    180,
                    430,
                    360,
                    110
                ]
            }
        },
        "next": [
            "公共_进入日常列表"
        ],
        "focus": {
            "Node.Action.Succeeded": "[color:Dimgray]礼物已送出，回任务页确认[/color]"
        }
    },
    "出行赠礼_点第一个礼物": {
        "desc": "点礼物列表第一个（左上角那张）。点几次就送几个；点够「送礼次数」后 max_hit 跳过本节点，转去「赠送」。点卡片中部，避开左上角的爱心（点爱心会改收藏）。不判断是否收藏：爱心颜色是角色代表色，不只金色",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "赠\\s*送",
                "roi": [
                    880,
                    630,
                    140,
                    60
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    760,
                    150,
                    150,
                    110
                ]
            }
        },
        "post_delay": 600,
        "max_hit": 1,
        "next": [
            "出行赠礼_点第一个礼物",
            "出行赠礼_赠送"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    }
}