{
    "校园合一": {
        "desc": "任务入口：进一次校园，依次做 出行（先收礼、再赠礼）→ 日程 → 画展，每做完一项按返回回到校园直接点下一项。10-24：收礼和赠礼都有明确结果时不再去任务页；只有结果不明时才去任务页，一次从上往下扫完「赠礼」「收礼」两行，没完成的点「前往」补做",
        "anchor": {
            "校园下一步": "校园_点出行",
            "收礼之后": "校园_去赠礼",
            "赠礼之后": "校园_出行做完",
            "校园收尾": "Flag_校园合一完成",
            "校园跳过": "校园_出行做完"
        },
        "timeout": 60000,
        "next": [
            "[JumpBack]公共_晚点再说",
            "[JumpBack]公共_生日弹窗等待",
            "[JumpBack]公共_稍后再说",
            "[JumpBack]公共_不再提醒",
            "[JumpBack]公共_我知道了",
            "校园_主界面进校园",
            "校园_主界面进校园_默认",
            "[JumpBack]公共_返回主界面"
        ],
        "on_error": [
            "公共_任务失败"
        ],
        "focus": {
            "Node.Action.Starting": "[color:Dimgray]开始：校园打包（出行收礼 + 赠礼 → 日程 → 画展）[/color]"
        }
    },
    "校园_主界面进校园": {
        "desc": "校园打包：全景 / 出行主题主界面右侧的「校园」（画廊在它正上方）。中途掉回主界面时也用它回到校园",
