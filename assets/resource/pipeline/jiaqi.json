                                                "expected": "^下次再说",
                                                "roi": [
                                                    300,
                                                    520,
                                                    680,
                                                    90
                                                ]
                                            }
                                        }
                                    }
                                ],
                                "box_index": 0
                            }
                        }
                    }
                ]
            }
