            "校园下一步": "佳期_点出行",
            "校园跳过": "佳期_没有出行"
        },
        "timeout": 60000,
        "next": [
            "[JumpBack]佳期_不退出",
            "佳期_计时中",
            "佳期_计划完成",
            "[JumpBack]公共_晚点再说",
            "[JumpBack]公共_生日弹窗等待",
            "[JumpBack]公共_稍后再说",
            "[JumpBack]公共_不再提醒",
            "[JumpBack]公共_我知道了",
            "[JumpBack]公共_出行邀约下次",
