        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 500,
            "timeout": 1500,
            "rate_limit": 200
        },
        "timeout": 5000,
        "next": [
            "画灵_已提升",
            "[JumpBack]公共_获得奖励",
            "[JumpBack]公共_跳过卡面",
