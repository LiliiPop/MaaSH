    "画灵_需突破": {
        "desc": "10-27 实机：等级到了当前阶段的上限（如「三阶画灵等级上限为70级」）时，等级那一行仍显示「+培养」，点了之后变成「突破后等级上限可提升至…」和「突破」按钮——要突破才能再升，不在这里突破，点右侧箭头换下一张画灵",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "突破后等级上限|^突\\s*破$",
                "roi": [
                    540,
