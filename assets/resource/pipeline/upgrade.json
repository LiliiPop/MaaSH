            "rate_limit": 200
        },
        "next": [
            "画灵_详情"
        ],
        "focus": {
            "Node.Action.Starting": "[color:Dimgray]这张画灵要突破才能再升，换下一张[/color]"
        }
    },
    "画灵_提升": {
        "desc": "「提升」是深色（材料够）才点。只升 1 级：点培养时游戏已经自动把目标设为 +1，不再点「+」",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "^提\\s*升$",
