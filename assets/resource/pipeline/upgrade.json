{
    "画灵_流程": {
        "desc": "在图鉴「画灵」列表：点第一张（从上到下、从左到右），进详情页后找等级未满的",
        "timeout": 20000,
        "next": [
            "画灵_点第一张",
            "[JumpBack]公共_获得奖励",
            "[JumpBack]公共_跳过卡面",
            "[JumpBack]公共_点击空白继续"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    },
    "画灵_点第一张": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "图鉴",
                "roi": [
                    114,
                    17,
                    152,
                    66
                ],
                "only_rec": true
            }
        },
        "desc": "10-27 实机：刚进图鉴、列表还在动时就点，点击被吞，停在列表干等 8 秒失败 → 点前先等列表静止；进不去详情就再点（最多 3 次）",
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    150,
                    175,
                    115,
                    110
                ]
            }
        },
        "max_hit": 3,
        "pre_wait_freezes": {
            "time": 800,
            "target": [
                120,
                150,
                1060,
                450
            ],
            "timeout": 4000,
            "rate_limit": 200
        },
        "post_wait_freezes": {
            "time": 500,
            "timeout": 1500,
            "rate_limit": 200
        },
        "next": [
            "画灵_详情"
        ]
    },
