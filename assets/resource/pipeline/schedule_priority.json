            "time": 500,
            "timeout": 3000,
            "rate_limit": 200
        },
        "action": "DoNothing",
        "timeout": 8000,
        "next": [
            "日程_选人_1",
            "日程_二页_刷新",
            "日程_选人_2",
            "日程_选人_3",
