            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "随机选择",
                                "roi": [
                                    115,
                                    600,
                                    125,
                                    50
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "INVITATION",
                                "roi": [
                                    765,
                                    315,
                                    120,
                                    40
                                ]
                            }
                        }
                    }
                ],
                "box_index": 0
            }
        },
