    "质检_周常领取": {
        "desc": "质检截图点：周常一键领取后的奖励。默认什么都不做；在「任务预设配置 → 质检截图」勾上后这里会截一张图（存 debug/screencap）",
        "recognition": {
            "type": "OCR",
