{
    "启动游戏": {
        "desc": "任务入口：启动游戏后进入等待循环",
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.netease.skzdhlr"
            }
        },
        "focus": {
            "Node.Action.Starting": "[color:Dimgray]正在启动时空中的绘旅人[/color]"
        },
        "next": [
            "启动_等待主界面"
        ]
    },
    "启动_等待主界面": {
        "desc": "循环判断：到主界面就确认，否则逐个处理登录、公告、断线、加载",
        "timeout": 300000,
        "next": [
            "启动_主界面初判",
            "[JumpBack]启动_切换账号",
            "[JumpBack]启动_点击登录",
            "[JumpBack]公共_关闭公告",
            "[JumpBack]公共_获得奖励",
            "[JumpBack]公共_点击空白继续",
            "[JumpBack]公共_断线重连",
            "[JumpBack]启动_兜底点击"
        ],
        "on_error": [
            "启动_超时"
        ]
    },
    "启动_主界面初判": {
        "desc": "认主界面右侧「画廊」和底部「图鉴」两个固定按钮（看板角色和背景会变，不用整图）。认出后等画面静止再复核一次，防止公告晚弹",
        "post_wait_freezes": {
            "time": 2000,
            "timeout": 15000
        },
        "next": [
            "Flag_启动完成",
            "[JumpBack]公共_关闭公告",
            "[JumpBack]公共_获得奖励",
            "[JumpBack]公共_点击空白继续"
        ],
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "画廊",
                                "roi": [
                                    950,
                                    290,
                                    120,
                                    80
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "图鉴",
                                "roi": [
                                    700,
                                    635,
                                    100,
                                    60
                                ]
                            }
                        }
                    }
                ]
            }
        }
    },
    "Flag_启动完成": {
        "desc": "画面静止后再次认出主界面，才算启动成功",
        "focus": {
            "Node.Action.Succeeded": "[color:Limegreen]启动完成，已在主界面[/color]"
        },
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "画廊",
                                "roi": [
                                    950,
                                    290,
                                    120,
                                    80
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "图鉴",
                                "roi": [
                                    700,
                                    635,
                                    100,
                                    60
                                ]
                            }
                        }
                    }
                ]
            }
        }
    },
    "启动_点击登录": {
        "desc": "登录界面：开屏图可自定义，认底部「点击屏幕开始」（部分文字也算），或右侧固定的「账号信息/用户协议/学院公告…」按钮列；点底部提示处进入",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "点击|屏幕开始",
                                "roi": [
                                    540,
                                    550,
                                    210,
                                    55
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": "号信息|用户协议|学院公告|自助修复|问题反馈",
                                "roi": [
                                    1160,
                                    60,
                                    110,
                                    410
                                ]
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    600,
                    560,
                    90,
                    30
                ]
            }
        },
        "max_hit": 5,
        "post_wait_freezes": {
            "time": 1000,
            "timeout": 20000
        }
    },
    "启动_切换账号": {
        "desc": "预留：在登录界面切换到指定账号。默认关闭，由「使用指定账号登录」选项打开",
        "enabled": false
    },
    "启动_兜底点击": {
        "desc": "兜底：画面静止 3 秒、又认不出任何已知界面时（例如换了新开屏），点一下底部中间进入游戏。只在启动阶段使用",
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    600,
                    560,
                    90,
                    30
                ]
            }
        },
        "max_hit": 15,
        "pre_wait_freezes": {
            "time": 3000,
            "timeout": 15000
        },
        "post_wait_freezes": {
            "time": 1000,
            "timeout": 15000
        }
    },
    "启动_超时": {
        "desc": "超过设定时间仍未进入主界面（例如版本更新、登录失效）：停止等待，交给人工处理",
        "focus": {
            "Node.Action.Succeeded": "[color:Red]启动超时：长时间没有进入主界面（可能在更新或需要登录），请人工处理[/color]"
        }
    }
}
