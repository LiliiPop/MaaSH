{
    "邮件": {
        "desc": "任务入口：确保在主界面后打开邮箱",
        "timeout": 60000,
        "next": [
            "邮件_打开邮箱",
            "[JumpBack]公共_返回主界面"
        ],
        "on_error": [
            "公共_任务失败"
        ],
        "focus": {
            "Node.Action.Starting": "[color:Dimgray]开始：邮件[/color]"
        }
    },
    "邮件_打开邮箱": {
        "desc": "主界面左上角信封图标（两种主题）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "home/邮件_全景.png",
                    "home/邮件_默认.png"
                ],
                "roi": [
                    90,
                    0,
                    200,
                    110
                ],
                "threshold": 0.75
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 800,
            "timeout": 10000
        },
        "next": [
            "邮件_全部领取"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    },
    "邮件_全部领取": {
        "desc": "右侧「全部领取并已读」。只领取，绝不点上方的「删除已读」",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "全部领取",
                "roi": [
                    1155,
                    510,
                    120,
                    70
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 1000,
            "timeout": 10000
        },
        "timeout": 15000,
        "next": [
            "邮件_等待"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    },
    "邮件_等待": {
        "timeout": 20000,
        "next": [
            "Flag_邮件完成",
            "[JumpBack]公共_获得奖励",
            "[JumpBack]公共_点击空白继续"
        ],
        "on_error": [
            "公共_任务失败"
        ]
    },
    "Flag_邮件完成": {
        "desc": "左下角未读数为 0/xxx",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^0/\\d+",
                "roi": [
                    60,
                    480,
                    150,
                    70
                ]
            }
        },
        "pre_wait_freezes": {
            "time": 1000,
            "timeout": 10000
        },
        "focus": {
            "Node.Action.Succeeded": "[color:Limegreen]邮件已全部领取[/color]"
        }
    }
}
