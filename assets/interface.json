{
    "interface_version": 2,
    "name": "MaaSH",
    "title": "MaaSH | 时空中的绘旅人日常小助手",
    "description": "基于 MaaFramework 的「时空中的绘旅人」日常小助手。只截图 + 模拟点击，不修改游戏。",
    "contact": "Github：https://github.com/LiliiPop/MaaSH",
    "license": "MIT",
    "welcome": "欢迎使用 MaaSH！首次使用请先看 README 里的「连接模拟器」一节。",
    "github": "https://github.com/LiliiPop/MaaSH",
    "version": "v0.0.1",
    // Mirror酱（国内下载加速）预留：申请到资源 ID 后取消下面两行的注释，并在 install.yml 里打开 MirrorChyanUploading 步骤
    // "mirrorchyan_rid": "MaaSH",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "ADB模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": ["./resource"]
        }
    ],
    "import": [
        "tasks/SmokeTest.json",
        "tasks/StartUp.json",
        "tasks/SignIn.json",
        "tasks/Mail.json",
        "tasks/MonthCard.json",
        "tasks/GiftBox.json",
        "tasks/Friend.json",
        "tasks/Schedule.json",
        "tasks/OutingGift.json",
        "tasks/OutingReceive.json",
        "tasks/Exhibition.json",
        "tasks/Gacha.json",
        "tasks/DailyClaim.json",
        "tasks/Holiday.json",
        "tasks/Stamina.json",
        "tasks/AfterRun.json",
        "tasks/CloseGame.json"
    ],
    "task": [],
    "option": {}
}
