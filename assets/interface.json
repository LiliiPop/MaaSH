    "group": [
        {
            "name": "start",
            "label": "🚀 启动",
            "description": "先启动游戏，其他任务都要在主界面开始。",
            "default_expand": true
        },
        {
            "name": "daily",
            "label": "☀️ 每日",
            "description": "每天跑一次的日常。打包任务进一次界面连做几项，比单项快。",
            "default_expand": true
        },
        {
            "name": "daily_single",
            "label": "🧩 每日单项（已含在打包里）",
            "description": "打包任务里已经包含这些，平时不用勾；只想补跑某一项时再单独勾。",
            "default_expand": false
        },
        {
            "name": "weekly",
            "label": "📅 每周",
            "description": "每周跑一次就够。",
            "default_expand": true
        },
        {
            "name": "claim",
            "label": "🎁 领奖励（放在日常之后）",
            "description": "做完上面的日常再领，才能把今天的进度都领到。",
            "default_expand": true
        },
