{
    "task": [
        {
            "name": "🎭手偶剧场三合一",
            "entry": "剧场三合一",
            "group": [
                "daily"
            ],
            "default_check": true,
            "description": "tasks/doc/Theater.md",
            "pipeline_override": {
                "剧场_点第一部": {
                    "next": [
                        "剧场_评论_唤出"
                    ]
                }
            },
            "option": [
                "评论内容",
                "领取观影券进度奖励"
            ]
        }
    ],
    "option": {
        "评论内容": {
            "type": "input",
            "description": "开启「剧场评论」时发送的内容（建议数字或英文）",
            "inputs": [
                {
                    "name": "内容",
                    "default": "1111",
                    "pipeline_type": "string",
                    "verify": "^.{1,30}$",
                    "pattern_msg": "1–30 个字"
                }
            ],
            "pipeline_override": {
                "剧场_评论_输入": {
                    "action": {
                        "type": "InputText",
                        "param": {
                            "input_text": "{内容}"
                        }
                    }
                }
            }
        },
        "领取观影券进度奖励": {
            "type": "select",
            "default_case": "开启",
            "description": "三合一完成后尝试领取社交页观影券进度奖励；已领过或没有奖励弹窗时正常返回。",
            "cases": [
                {
                    "name": "开启",
                    "pipeline_override": {
                        "剧场_完成": {
                            "next": [
                                "剧场_领券_完成"
                            ]
                        }
                    }
                },
                {
                    "name": "关闭",
                    "pipeline_override": {
                        "剧场_完成": {
                            "next": []
                        }
                    }
                }
            ]
        }
    }
}
