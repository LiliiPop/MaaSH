{
    "task": [
        {
            "name": "🎭手偶剧场点赞",
            "entry": "手偶剧场",
            "default_check": true,
            "description": "任务页「手偶剧场点赞1次」前往：社交 → 作品 → 热门剧场第一部，播完后点赞（原来就是红心会先取消再点），返回社交确认已完成。<br>播放要等 1–3 分钟。<br>可选「剧场评论」：播放时点画面 → 点底部输入框 → 点上方输入栏 → 输入「评论内容」→ 点纸飞机发送。评论内容建议只用数字或英文（模拟器里输入中文可能失败）。今天已经点过赞时整个任务会跳过，评论也不会发。",
            "option": [
                "剧场评论",
                "评论内容"
            ]
        }
    ],
    "option": {
        "剧场评论": {
            "type": "select",
            "default_case": "不评论",
            "description": "播放时顺便发一条评论，完成社交页「评论一次他人的视频」",
            "cases": [
                {
                    "name": "不评论"
                },
                {
                    "name": "评论",
                    "pipeline_override": {
                        "剧场_点第一部": {
                            "next": [
                                "剧场_评论_唤出"
                            ]
                        }
                    }
                }
            ]
        },
        "评论内容": {
            "type": "input",
            "description": "开启「剧场评论」时发送的内容（建议数字或英文）",
            "inputs": [
                {
                    "name": "内容",
                    "default": "1111",
                    "pipeline_type": "string",
                    "verify": "^.{1,30}$",
                    "pattern_msg": "1–30 个字"
                }
            ],
            "pipeline_override": {
                "剧场_评论_输入": {
                    "action": {
                        "type": "InputText",
                        "param": {
                            "input_text": "{内容}"
                        }
                    }
                }
            }
        }
    }
}
