{
    "task": [
        {
            "name": "🎭手偶剧场三合一",
            "entry": "剧场三合一",
            "group": [
                "daily"
            ],
            "default_check": true,
            "description": "tasks/doc/Theater.md",
            "pipeline_override": {
                "剧场_点第一部": {
                    "next": [
                        "剧场_评论_唤出"
                    ]
                }
            },
            "option": [
                "评论内容"
            ]
        }
    ],
    "option": {
        "评论内容": {
            "type": "input",
            "description": "开启「剧场评论」时发送的内容（建议数字或英文）",
            "inputs": [
                {
                    "name": "内容",
                    "default": "1111",
                    "pipeline_type": "string",
                    "verify": "^.{1,30}$",
                    "pattern_msg": "1–30 个字"
                }
            ],
            "pipeline_override": {
                "剧场_评论_输入": {
                    "action": {
                        "type": "InputText",
                        "param": {
                            "input_text": "{内容}"
                        }
                    }
                }
            }
        }
    }
}