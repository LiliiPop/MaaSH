{
    "task": [
        {
            "name": "✈️启动绘旅人",
            "entry": "启动游戏",
            "default_check": true,
            "option": [
                "启动等待上限",
                "使用指定账号登录",
                "质检截图"
            ],
            "description": "启动游戏，点击登录界面进入默认账号，关闭所有公告，停在主界面。<br>可设置等待上限；认不出的开屏会在画面静止后点底部进入。"
        }
    ],
    "option": {
        "使用指定账号登录": {
            "type": "switch",
            "description": "预留功能，暂未实现。",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "启动_切换账号": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "启动_切换账号": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "启动等待上限": {
            "type": "select",
            "label": "启动等待上限",
            "description": "打开游戏后多久还没进入主界面就停止等待、交给人工（读条、版本更新可能较慢）。选「不限制」则一直等。",
            "default_case": "10分钟",
            "cases": [
                {
                    "name": "5分钟",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 300000
                        }
                    }
                },
                {
                    "name": "10分钟",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 600000
                        }
                    }
                },
                {
                    "name": "20分钟",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 1200000
                        }
                    }
                },
                {
                    "name": "30分钟",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 1800000
                        }
                    }
                },
                {
                    "name": "不限制",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 86400000
                        }
                    }
                }
            ]
        },
        "质检截图": {
            "type": "select",
            "default_case": "关闭",
            "description": "任务<b>完成的那一刻</b>自动截一张图，用来统一检查脚本有没有做对（失败时的截图本来就会自动存在 debug\\on_error）。<br>图片存在 <b>MaaSH 目录\\debug\\screencap</b>，文件名是「时间_节点名」。双击 MaaSH 目录里的「打开质检截图.bat」可以直接打开这个文件夹。<br><b>图片不会自动删除</b>：每张约 100–200 KB，请定期清理。双击「清理质检截图.bat」删除 7 天前的图，也可以用它设置成每天自动清理。",
