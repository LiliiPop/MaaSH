        "登录账号": {
            "type": "input",
            "description": "历史账号列表里显示的账号文字（邮箱 / 手机号的一部分即可，例如邮箱 @ 前面那段）",
            "inputs": [
                {
                    "name": "账号",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^.{2,40}$",
                    "pattern_msg": "填 2 个字以上"
                }
            ],
            "pipeline_override": {
                "账号_已选中": {
