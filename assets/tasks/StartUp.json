{
    "task": [
        {
            "name": "✈️启动绘旅人",
            "entry": "启动游戏",
            "default_check": true,
            "option": [
                "启动等待上限",
                "使用指定账号登录"
            ],
            "description": "启动游戏，点击登录界面进入默认账号，关闭所有公告，停在主界面。<br>可设置等待上限；认不出的开屏会在画面静止后点底部进入。<br><b>第一次使用</b>：MuMu 分辨率设成 1280×720（设置中心 → 显示 → 平板版），先在模拟器里手动登录一次游戏；完整的 MuMu 和 MaaSH 设置步骤见公告（设置 → 关于 → 显示公告）。"
        }
    ],
    "option": {
        "使用指定账号登录": {
            "type": "switch",
            "description": "进主界面后切换到指定账号：设置 → 退出账号 → 在网易登录框的<b>历史账号列表</b>里选「登录账号」里填的账号 → 登录。<br><b>不保存、不输入密码</b>：要切的账号必须先在这个模拟器上手动登录过一次。登录时如果弹出短信安全验证，脚本会停下来。",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "登录账号"
                    ],
                    "pipeline_override": {
                        "Flag_启动完成": {
                            "next": [
                                "账号_开始",
                                "账号_已切换"
                            ]
                        }
                    }
                }
            ]
        },
        "启动等待上限": {
            "type": "select",
            "label": "启动等待上限",
            "description": "打开游戏后多久还没进入主界面就停止等待、交给人工（读条、版本更新可能较慢）。选「不限制」则一直等。",
            "default_case": "10分钟",
            "cases": [
                {
                    "name": "5分钟",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 300000
                        }
                    }
                },
                {
                    "name": "10分钟",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 600000
                        }
                    }
                },
                {
                    "name": "20分钟",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 1200000
                        }
                    }
                },
                {
                    "name": "30分钟",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 1800000
                        }
                    }
                },
                {
                    "name": "不限制",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 86400000
                        }
                    }
                }
            ]
        },
        "质检截图": {
            "type": "checkbox",
            "default_case": [],
            "description": "勾选的环节<b>完成的那一刻</b>自动截一张图，用来检查脚本有没有做对（失败时的截图本来就会自动存在 debug\\on_error）。<br>图片存在 <b>MaaSH 目录\\debug\\screencap</b>，文件名是「时间_节点名」。<br><b>图片不会自动删除</b>（每张约 100–200 KB），请定期手动清理。<br>不勾 = 不截图。",
            "cases": [
                {
                    "name": "启动游戏",
                    "pipeline_override": {
                        "Flag_启动完成": {
                            "action": {
