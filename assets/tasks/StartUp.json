{
    "task": [
        {
            "name": "✈️启动绘旅人",
            "label": "✈️启动游戏",
            "entry": "启动游戏",
            "group": [
                "start"
            ],
            "default_check": true,
            "option": [
                "启动等待上限",
                "使用指定账号登录",
                "B服登录记录核对"
            ],
            "description": "tasks/doc/StartUp.md"
        }
    ],
    "option": {
        "使用指定账号登录": {
            "type": "switch",
            "description": "进主界面后切换到指定账号：设置 → 退出账号 → 在网易登录框的<b>历史账号列表</b>里选「登录账号」里填的账号 → 登录。<br><b>不保存、不输入密码</b>：要切的账号必须先在这个模拟器上手动登录过一次。登录时如果弹出短信安全验证，脚本会停下来。",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "登录账号"
                    ],
                    "pipeline_override": {
                        "Flag_启动完成": {
                            "next": [
                                "账号_开始",
                                "账号_已切换"
                            ]
                        }
                    }
                }
            ],
            "resource": [
                "官服"
            ]
        },
        "启动等待上限": {
            "type": "select",
            "label": "启动等待上限",
            "description": "打开游戏后多久还没进入主界面就停止等待、交给人工（读条、版本更新可能较慢）。选「不限制」则一直等。",
            "default_case": "10分钟",
            "cases": [
                {
                    "name": "5分钟",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 300000
                        }
                    }
                },
                {
                    "name": "10分钟",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 600000
                        }
                    }
                },
                {
                    "name": "20分钟",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 1200000
                        }
                    }
                },
                {
                    "name": "30分钟",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 1800000
                        }
                    }
                },
                {
                    "name": "不限制",
                    "pipeline_override": {
                        "启动_等待主界面": {
                            "timeout": 86400000
                        }
                    }
                }
            ]
        },
        "质检截图": {
            "type": "checkbox",
            "default_case": [],
            "description": "勾选的环节到了<b>结算 / 奖励页面</b>时自动截一张图，用来检查脚本有没有做对（失败时的截图本来就会自动存在 debug\\on_error）。<br>图片存在 <b>MaaSH 目录\\debug\\screencap</b>，文件名是「时间_节点名」。<br><b>图片不会自动删除</b>（每张约 100–200 KB），请定期手动清理。<br>不勾 = 不截图。",
            "cases": [
                {
                    "name": "手偶剧场结算",
                    "pipeline_override": {
                        "质检_剧场结算": {
                            "action": {
                                "type": "Screencap",
                                "param": {
                                    "format": "jpg",
                                    "quality": 85
                                }
                            }
                        }
                    }
                },
                {
                    "name": "月卡领取（已领取页面）",
                    "pipeline_override": {
                        "Flag_月卡完成": {
                            "action": {
                                "type": "Screencap",
                                "param": {
                                    "format": "jpg",
                                    "quality": 85
                                }
                            }
                        }
                    }
                },
                {
                    "name": "领邮件结算",
                    "pipeline_override": {
                        "质检_邮件结算": {
                            "action": {
                                "type": "Screencap",
                                "param": {
                                    "format": "jpg",
                                    "quality": 85
                                }
                            }
                        }
                    }
                },
                {
                    "name": "每日任务领取",
                    "pipeline_override": {
                        "质检_每日领取": {
                            "action": {
                                "type": "Screencap",
                                "param": {
                                    "format": "jpg",
                                    "quality": 85
                                }
                            }
                        }
                    }
                },
                {
                    "name": "周常领取",
                    "pipeline_override": {
                        "质检_周常领取": {
                            "action": {
                                "type": "Screencap",
                                "param": {
                                    "format": "jpg",
                                    "quality": 85
                                }
                            }
                        }
                    }
                },
                {
                    "name": "月卡每周购买",
                    "pipeline_override": {
                        "质检_月卡购买": {
                            "action": {
                                "type": "Screencap",
                                "param": {
                                    "format": "jpg",
                                    "quality": 85
                                }
                            }
                        }
                    }
                },
                {
                    "name": "绘卷回忆扫荡",
                    "pipeline_override": {
                        "质检_绘卷扫荡": {
                            "action": {
                                "type": "Screencap",
                                "param": {
                                    "format": "jpg",
                                    "quality": 85
                                }
                            }
                        }
                    }
                },
                {
                    "name": "假日领取",
                    "pipeline_override": {
                        "质检_假日领取": {
                            "action": {
                                "type": "Screencap",
                                "param": {
                                    "format": "jpg",
                                    "quality": 85
                                }
                            }
                        }
                    }
                },
                {
                    "name": "时光电影院兑换完",
                    "pipeline_override": {
                        "Flag_兑换完成": {
                            "action": {
                                "type": "Screencap",
                                "param": {
                                    "format": "jpg",
                                    "quality": 85
                                }
                            }
                        }
                    }
                },
                {
                    "name": "日程结算",
                    "pipeline_override": {
                        "质检_日程结算": {
                            "action": {
                                "type": "Screencap",
                                "param": {
                                    "format": "jpg",
                                    "quality": 85
                                }
                            }
                        }
                    }
                }
            ]
        },
        "登录账号": {
            "type": "input",
            "description": "历史账号列表里显示的账号文字（邮箱 / 手机号的一部分即可，例如邮箱 @ 前面那段）",
            "inputs": [
                {
                    "name": "账号",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^.{2,40}$",
                    "pattern_msg": "填 2 个字以上"
                }
            ],
            "pipeline_override": {
                "账号_已选中": {
                    "recognition": {
                        "type": "OCR",
                        "param": {
                            "expected": "{账号}",
                            "roi": [
                                440,
                                280,
                                440,
                                55
                            ]
                        }
                    }
                },
                "账号_选账号": {
                    "recognition": {
                        "type": "OCR",
                        "param": {
                            "expected": "{账号}",
                            "roi": [
                                440,
                                270,
                                480,
                                330
                            ]
                        }
                    }
                }
            }
        },
        "B服登录记录核对": {
            "type": "select",
            "resource": [
                "B服"
            ],
            "default_case": "关闭",
            "description": "只核对已保存的 B服登录记录，不主动注销当前账号；找不到指定昵称时停止。",
            "cases": [
                {
                    "name": "关闭"
                },
                {
                    "name": "开启",
                    "option": [
                        "B服登录账号昵称"
                    ],
                    "pipeline_override": {
                        "B服_账号选择等待登录记录": {
                            "enabled": true
                        },
                        "B服_sub_登录账号": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "B服登录账号昵称": {
            "type": "input",
            "label": "已保存账号的昵称片段",
            "description": "须为已添加且成功登录过的账号。可填昵称前三字或其他容易识别的唯一片段；如果多个昵称包含相同片段，请填写更长内容以区分。找不到或核对不符时停止。无需填写密码。",
            "inputs": [
                {
                    "name": "账号昵称",
                    "label": "昵称前三字或唯一片段",
                    "default": "请填写已保存账号昵称",
                    "pipeline_type": "string",
                    "verify": "^[一-龥A-Za-z0-9_-]{1,32}$",
                    "pattern_msg": "请填写1至32位昵称，支持汉字、字母、数字、下划线、短横线。"
                }
            ],
            "pipeline_override": {
                "B服_账号选择目标": {
                    "all_of": [
                        "B服_登录记录标识",
                        {
                            "recognition": "OCR",
                            "roi": [
                                530,
                                270,
                                215,
                                195
                            ],
                            "expected": "{账号昵称}"
                        }
                    ]
                },
                "B服_账号核对并登录": {
                    "all_of": [
                        "B服_登录记录标识",
                        {
                            "recognition": "OCR",
                            "roi": [
                                530,
                                275,
                                215,
                                70
                            ],
                            "expected": "{账号昵称}"
                        },
                        {
                            "recognition": "OCR",
                            "roi": [
                                480,
                                365,
                                335,
                                85
                            ],
                            "expected": "^登录$"
                        }
                    ]
                }
            },
            "resource": [
                "B服"
            ]
        }
    }
}