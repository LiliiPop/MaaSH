{
    "task": [
        {
            "name": "🎁出行赠礼",
            "entry": "出行赠礼",
            "default_check": true,
            "description": "从任务页「给任意角色赠送礼物」前往：换成选定角色，打开赠礼，<b>直接送礼物列表里的第一个</b>（不判断是否收藏）。<br>「送礼次数」= 点第一个礼物几下 = 送几个，默认 1。第一个礼物的库存比次数少时，按库存送完为止。",
            "option": [
                "赠礼角色",
                "送礼次数",
                "质检截图"
            ]
        }
    ],
    "option": {
        "赠礼角色": {
            "type": "select",
            "cases": [
                {
                    "name": "艾因",
                    "pipeline_override": {
