{
    "task": [
        {
            "name": "🎁出行赠礼",
            "entry": "出行赠礼",
            "group": [
                "daily_single"
            ],
            "default_check": false,
            "description": "tasks/doc/OutingGift.md"
        }
    ],
    "option": {
        "赠礼角色": {
            "type": "select",
            "cases": [
                {
                    "name": "艾因",
                    "pipeline_override": {
                        "出行赠礼_选择角色": {
                            "next": [
                                "赠礼找人_艾因_1"
                            ]
                        }
                    }
                },
                {
                    "name": "路辰",
                    "pipeline_override": {
                        "出行赠礼_选择角色": {
                            "next": [
                                "赠礼找人_路辰_1"
                            ]
                        }
                    }
                },
                {
                    "name": "罗夏",
                    "pipeline_override": {
                        "出行赠礼_选择角色": {
                            "next": [
                                "赠礼找人_罗夏_1"
                            ]
                        }
                    }
                },
                {
                    "name": "司岚",
                    "pipeline_override": {
                        "出行赠礼_选择角色": {
                            "next": [
                                "赠礼找人_司岚_1"
                            ]
                        }
                    }
                },
                {
                    "name": "叶瑄",
                    "pipeline_override": {
                        "出行赠礼_选择角色": {
                            "next": [
                                "赠礼找人_叶瑄_1"
                            ]
                        }
                    }
                }
            ],
            "description": "<br>按头像头顶的<b>发色</b>认人（黑 艾因 / 深蓝 司岚 / 橙 罗夏 / 金 路辰 / 银 叶瑄），换装扮也认得出；头像栏顺序随好感度变也没关系。认不出时改用头像栏第一个角色。（校园那个打包任务和出行赠礼、出行收礼共用这一个设置，选一次就记住）"
        },
        "送礼次数": {
            "type": "input",
            "description": "每次送几个第一个礼物（点几下就送几个）（校园那个打包任务和出行赠礼、出行收礼共用这一个设置，选一次就记住）",
            "inputs": [
                {
                    "name": "次数",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$",
                    "pattern_msg": "填 1 以上的整数"
                }
            ],
            "pipeline_override": {
                "出行赠礼_点第一个礼物": {
                    "max_hit": "{次数}"
                },
                "出行赠礼_跳过倾心": {
                    "max_hit": "{次数}"
                }
            }
        }
    }
}