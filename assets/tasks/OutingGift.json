                                "type": "TemplateMatch",
                                "param": {
                                    "template": [
                                        "outing/艾因.png",
                                        "outing/艾因_2.png"
                                    ],
                                    "roi": [
                                        30,
                                        610,
                                        520,
                                        90
                                    ],
                                    "threshold": 0.75
                                }
                            }
                        }
                    }
                },
